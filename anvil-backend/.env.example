# Admin password (at least 8 characters)
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Random text used to sign admin login cookies.
SESSION_SECRET=replace-with-a-random-secret

# Comma-separated website origins. Leave blank for local development only.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Neon PostgreSQL connection string. Replace this placeholder with your own value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local server port
PORT=3000

# Set to production when deployed over HTTPS. Production requires HTTPS origins.
# NODE_ENV=production
