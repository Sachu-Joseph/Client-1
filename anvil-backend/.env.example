# Admin password (at least 8 characters)
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Random text used to sign admin login cookies.
SESSION_SECRET=replace-with-a-random-secret

# Comma-separated website origins. Leave blank for local development only.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Port and database location
PORT=3000
# DB_PATH=./data/trials.db

# Set to production when deployed over HTTPS.
# NODE_ENV=production
